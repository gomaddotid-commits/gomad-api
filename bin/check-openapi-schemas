#!/usr/bin/env python3
"""Mencari skema kosong (`{}`) dan tipe gabungan pada kontrak OpenAPI.

Skema seperti ini membuat generator Dart menghasilkan kelas tanpa properti atau
`anyOf` yang tidak bisa dikompilasi. Gunakan daftar hasilnya sebagai daftar kerja
saat memperbaiki tipe respons di controller.
"""

import sys

import yaml


def walk(node, path=""):
    if isinstance(node, dict):
        if node == {}:
            yield f"KOSONG  {path}"
            return
        if "anyOf" in node:
            yield f"ANYOF   {path}"
        for key, value in node.items():
            yield from walk(value, f"{path}/{key}")
    elif isinstance(node, list):
        for index, value in enumerate(node):
            yield from walk(value, f"{path}[{index}]")


def main() -> int:
    source = sys.argv[1] if len(sys.argv) > 1 else "openapi/openapi.yaml"
    with open(source) as handle:
        document = yaml.safe_load(handle)

    findings = sorted(walk(document.get("paths", {}), "/paths"))
    for finding in findings:
        print(finding)

    kosong = sum(1 for finding in findings if finding.startswith("KOSONG"))
    anyof = len(findings) - kosong
    print(f"\n{kosong} skema kosong, {anyof} tipe gabungan", file=sys.stderr)

    return 0 if not findings else 1


if __name__ == "__main__":
    raise SystemExit(main())
