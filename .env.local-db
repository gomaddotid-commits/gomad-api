# Override database untuk pengembangan lokal saat instance Aiven tidak tersedia.
# Dipakai otomatis oleh bin/compose bila berkas ini ada (dibaca SETELAH kredensial Aiven,
# sehingga menimpa DB_* dari ../kredensial/aiven-mysql-db.txt).
# Hapus/rename berkas ini untuk kembali memakai Aiven.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gomad_restore
DB_USERNAME=root
DB_PASSWORD=gomad-root-local
